CLICKHOUSE_DB=logs
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000   # used by goose

# Migrations (goose binary: PATH, ./bin, or GOOSE_BIN)
# GOOSE_BIN=
# MIGRATIONS_DIR=./migrations

# Anomaly detection (message RandomForest from ../anamoly_detection_ml)
ANOMALY_DETECTION=true
# ANOMALY_MODEL_PATH=../anamoly_detection_ml/artifacts/message_detector.joblib
# ANOMALY_THRESHOLD=   # empty: use the threshold stored in the model

# Mock-Data-Gen API (source of the security-log stream)
MOCK_API_URL=http://localhost:8000
MOCK_API_DATASET=security_logs
# Create the dataset and start streaming automatically if it is not running
MOCK_API_AUTO_START=true
MOCK_API_EPS=20
MOCK_API_ANOMALIES_PER_MINUTE=2

# Load
ETL_BATCH_SIZE=1000
ETL_FLUSH_INTERVAL=5
